<Window x:Class="HuaweiHROverlay.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Huawei HR Overlay"
        Width="590" Height="800"
        MinWidth="500" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDeepBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}"
        ResizeMode="CanResize">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Top App Bar -->
            <RowDefinition Height="*"/>
            <!-- Scrollable Studio Body -->
            <RowDefinition Height="Auto"/>
            <!-- Pinned Status Footer -->
        </Grid.RowDefinitions>

        <!-- ══════ TOP APP BAR ══════ -->
        <Border Grid.Row="0" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,0,0,1" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="8" Background="#24FF3B5C" BorderBrush="#48FF3B5C" BorderThickness="1" Margin="0,0,10,0">
                        <Path Data="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
                              Fill="{StaticResource AccentRedBrush}" Stretch="Uniform" Width="16" Height="16"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Huawei HR Overlay" FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Border CornerRadius="5" Background="#1D2234" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="VersionBadgeText" Text="v1.2.0" FontSize="10.5" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="BLE Heart Rate Broadcast Studio for OBS" FontSize="11" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="CheckUpdateButton" Content="↻  Check Updates" Style="{StaticResource SubtleButton}"
                            Click="CheckUpdateButton_Click" ToolTip="Check GitHub Releases for a newer version"/>
                    <Button Content="GitHub ↗" Style="{StaticResource SubtleButton}" Margin="4,0,0,0"
                            Click="OpenRepo_Click" ToolTip="Open fishuvn/huawei-hr-overlay on GitHub"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══════ SCROLLABLE MAIN STUDIO ══════ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="20,16,20,16">

                <!-- ══════ GITHUB UPDATE BANNER (Hidden unless update available) ══════ -->
                <Border x:Name="UpdateBannerCard" Style="{StaticResource AccentCard}" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#30FF3B5C" CornerRadius="5" Padding="7,2" Margin="0,0,8,0">
                                    <TextBlock Text="UPDATE AVAILABLE" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource AccentRedBrightBrush}"/>
                                </Border>
                                <TextBlock x:Name="UpdateTitleText" Text="v1.2.0" FontSize="13.5" FontWeight="Bold" VerticalAlignment="Center"/>
                                <TextBlock x:Name="UpdateMetaText" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
                            </StackPanel>

                            <Button x:Name="DismissUpdateButton" Grid.Column="1" Content="✕" Style="{StaticResource SubtleButton}"
                                    Padding="6,2" Click="DismissUpdate_Click" ToolTip="Hide update notice"/>
                        </Grid>

                        <Border Background="#10121C" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,10,0,10" MaxHeight="88">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <TextBlock x:Name="UpdateNotesText" Text="" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Border>

                        <!-- Download Progress -->
                        <StackPanel x:Name="UpdateProgressPanel" Visibility="Collapsed" Margin="0,0,0,10">
                            <ProgressBar x:Name="UpdateProgressBar" Style="{StaticResource DarkProgressBar}" Minimum="0" Maximum="100" Value="0"/>
                            <TextBlock x:Name="UpdateProgressText" Text="Preparing download…" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,5,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="InstallUpdateButton" Content="⬇  Download &amp; Restart" Style="{StaticResource PrimaryButton}"
                                    Padding="14,7" Click="InstallUpdateButton_Click"/>
                            <Button x:Name="CancelUpdateButton" Content="Cancel" Style="{StaticResource GhostButton}"
                                    Padding="12,7" Margin="8,0,0,0" Visibility="Collapsed" Click="CancelUpdateButton_Click"/>
                            <Button Content="Release Notes ↗" Style="{StaticResource SecondaryButton}"
                                    Padding="12,7" Margin="8,0,0,0" Click="OpenReleasePage_Click"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ══════ HERO TELEMETRY CARD ══════ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: Active Device + BPM + Zone + Session Stats -->
                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock x:Name="HeroDeviceLabel" Text="NO ACTIVE WATCH" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="LiveBpm" Text="--" Style="{StaticResource BigBpmLabel}"/>
                                <StackPanel Margin="12,8,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="BPM" FontSize="12" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                    <Border x:Name="ZonePillBorder" CornerRadius="6" Padding="8,3" Margin="0,4,0,0" Background="#1C2030">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse x:Name="ZoneDot" Width="6" Height="6" Fill="{StaticResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBlock x:Name="ZoneLabel" Text="Waiting for signal" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Session Min / Avg / Peak Strip -->
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="MIN " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="StatMinText" Text="--" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="AVG " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="StatAvgText" Text="--" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,0,6,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="PEAK " FontSize="10" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}"/>
                                        <TextBlock x:Name="StatMaxText" Text="--" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource MonoFont}"/>
                                    </StackPanel>
                                </Border>
                                <Button Content="Reset" Style="{StaticResource SubtleButton}" Padding="6,3" FontSize="10.5"
                                        Click="ResetStats_Click" ToolTip="Reset session Min / Avg / Peak"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right: Connection Badge + Simulator Switch + Live Trend Sparkline -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Border x:Name="ConnBadge" CornerRadius="11" Padding="10,4" Background="#1A888888">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="#888888" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBlock x:Name="ConnText" Text="Disconnected" FontSize="11" FontWeight="SemiBold" Foreground="#94A3B8"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <CheckBox x:Name="SimMode" Content="Simulate HR" Style="{StaticResource PillSwitch}"
                                      Margin="0,10,0,10" HorizontalAlignment="Right"
                                      Checked="SimMode_Checked" Unchecked="SimMode_Unchecked"
                                      ToolTip="Stream realistic test BPM values to OBS without a watch"/>

                            <!-- Live 45-Sample Trend Sparkline -->
                            <Border Width="178" Height="56" Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <Grid>
                                    <TextBlock x:Name="SparklinePlaceholder" Text="Live BPM trend" FontSize="10" Foreground="{StaticResource TextMutedBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Canvas Width="176" Height="54" ClipToBounds="True">
                                        <Polygon x:Name="SparklineFill" Opacity="0.22" Fill="{StaticResource AccentRedBrush}"/>
                                        <Polyline x:Name="SparklineStroke" Stroke="{StaticResource AccentRedBrush}" StrokeThickness="1.8" StrokeLineJoin="Round"/>
                                    </Canvas>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ══════ CONNECTED DEVICES (LIVE) ══════ -->
                <Border x:Name="ConnectedCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="CONNECTED — LIVE" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <Border Background="#2022C55E" CornerRadius="5" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ConnectedCountText" Text="1" FontSize="10" FontWeight="Bold" Foreground="{StaticResource GreenOkBrush}"/>
                                </Border>
                            </StackPanel>

                            <CheckBox x:Name="AutoReconnectCheck" Grid.Column="1" Content="Auto-reconnect"
                                      Style="{StaticResource PillSwitch}" IsChecked="True"
                                      Checked="AutoReconnect_Changed" Unchecked="AutoReconnect_Changed"
                                      ToolTip="Automatically reconnect if watch briefly steps out of Bluetooth range"/>
                        </Grid>

                        <ItemsControl x:Name="ConnectedList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BgInputBrush}" BorderBrush="{Binding RowBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="11,8" Margin="0,0,0,6"
                                            MouseLeftButtonDown="ConnectedRow_MouseLeftButtonDown" Cursor="Hand"
                                            ToolTip="Click row to focus in Hero telemetry and OBS URL builder">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StateDotBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                    <Border Background="#1B2234" CornerRadius="4" Padding="5,1" Margin="7,0,0,0" Visibility="{Binding HeroTagVisibility}">
                                                        <TextBlock Text="FOCUSED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource BlueInfoBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding SubtitleText}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="14,2,0,0"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0">
                                                <TextBlock Text="{Binding BpmDisplay}" FontSize="17" FontWeight="Bold" Foreground="{Binding BpmBrush}" FontFamily="{StaticResource MonoFont}"/>
                                                <TextBlock Text="BPM" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Bottom" Margin="4,0,0,2"/>
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Content="{Binding CopyButtonLabel}" Style="{StaticResource SecondaryButton}" Padding="9,4" FontSize="11"
                                                        Click="CopyDeviceUrl_Click" ToolTip="Copy OBS Browser Source URL locked to this device"/>
                                                <Button Content="↗" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="5,0,0,0"
                                                        Click="PreviewDeviceUrl_Click" ToolTip="Preview this device's overlay in browser"/>
                                                <Button Content="✕" Style="{StaticResource GhostButton}" Padding="8,4" FontSize="11" Margin="5,0,0,0"
                                                        Click="DisconnectConnected_Click" ToolTip="Disconnect device"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- ══════ BLUETOOTH SCANNER & DEVICE DISCOVERY ══════ -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="BLUETOOTH LE SCANNER" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                    <Ellipse x:Name="ScanningPulseDot" Width="6" Height="6" Fill="{StaticResource GreenOkBrush}" Margin="7,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                                <TextBlock x:Name="ScanStatus" Text="Enable HR Data Broadcast on watch, then click Scan."
                                           Style="{StaticResource StatusText}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <CheckBox x:Name="HrOnlyFilterCheck" Content="HR Only" Style="{StaticResource ChipCheck}" Margin="0,0,8,0" VerticalAlignment="Center"
                                          Checked="HrOnlyFilter_Changed" Unchecked="HrOnlyFilter_Changed"
                                          ToolTip="Show only wearables and devices advertising Heart Rate Service"/>
                                <Button x:Name="ScanButton" Content="▶  Scan" Style="{StaticResource SecondaryButton}"
                                        Padding="13,6" Click="ScanButton_Click"/>
                                <Button x:Name="StopScanButton" Content="■  Stop" Style="{StaticResource GhostButton}"
                                        Padding="12,6" Margin="6,0,0,0" Click="StopScanButton_Click" IsEnabled="False"/>
                            </StackPanel>
                        </Grid>

                        <!-- Discovered Devices List + Empty State -->
                        <Border Background="{StaticResource BgInputBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="9" MinHeight="148" MaxHeight="215" ClipToBounds="True">
                            <Grid>
                                <ListBox x:Name="DeviceList"
                                         Style="{StaticResource DeviceListBox}"
                                         ItemContainerStyle="{StaticResource DeviceListItem}"
                                         SelectionChanged="DeviceList_SelectionChanged"
                                         MouseDoubleClick="DeviceList_MouseDoubleClick">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}"/>
                                                        <Border Background="{Binding BadgeBgBrush}" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding BadgeText}" FontSize="9.5" FontWeight="Bold" Foreground="{Binding BadgeFgBrush}"/>
                                                        </Border>
                                                        <Border Background="#2222C55E" CornerRadius="4" Padding="6,1" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding ConnectedPillVisibility}">
                                                            <TextBlock Text="CONNECTED" FontSize="9" FontWeight="Bold" Foreground="{StaticResource GreenOkBrush}"/>
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding AddressSubtitle}" FontSize="10.5" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextMutedBrush}" Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                                    <TextBlock Text="{Binding SignalBarsGlyph}" FontSize="11" FontFamily="{StaticResource MonoFont}" Foreground="{Binding SignalBrush}" HorizontalAlignment="Right"/>
                                                    <TextBlock Text="{Binding RssiDisplay}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Empty / First-Use State -->
                                <StackPanel x:Name="EmptyScanOverlay" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24,18">
                                    <TextBlock x:Name="EmptyScanTitle" Text="Ready to discover watches" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock x:Name="EmptyScanSubtitle"
                                               Text="On your Huawei Watch/Band open Settings → HR Data Broadcasts → ON, then press Scan."
                                               FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Connect Action Row -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ConnectButton" Content="⚡  Connect Watch" Style="{StaticResource PrimaryButton}"
                                    IsEnabled="False" Click="ConnectButton_Click"
                                    ToolTip="Connect selected watch (or double-click any device row)"/>
                            <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource StatusText}"
                                       Text="Tip: Double-click a device to connect. Connect multiple watches for co-op streams."/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ══════ OBS STUDIO OVERLAY CUSTOMIZER ══════ -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="OBS BROWSER SOURCE STUDIO" Style="{StaticResource SectionLabel}" VerticalAlignment="Center"/>
                                <Border Background="#1B2234" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="ObsTargetBadge" Text="Target: Any Active Watch" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource BlueInfoBrush}"/>
                                </Border>
                            </StackPanel>
                            <Button x:Name="UseGlobalUrlButton" Grid.Column="1" Content="Use Global URL" Style="{StaticResource SubtleButton}"
                                    Padding="7,3" FontSize="10.5" Visibility="Collapsed" Click="UseGlobalUrl_Click"
                                    ToolTip="Switch URL back from single-device lock to global latest watch"/>
                        </Grid>

                        <!-- Style Presets -->
                        <TextBlock Text="Theme Preset" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,10">
                            <RadioButton x:Name="ThemeGlassRadio" Content="Glass Card" GroupName="ObsTheme" Style="{StaticResource ChipRadio}" IsChecked="True" Checked="ObsOption_Changed"/>
                            <RadioButton x:Name="ThemeMinimalRadio" Content="Minimal Clean" GroupName="ObsTheme" Style="{StaticResource ChipRadio}" Checked="ObsOption_Changed"/>
                            <RadioButton x:Name="ThemeNeonRadio" Content="Neon Cyber" GroupName="ObsTheme" Style="{StaticResource ChipRadio}" Checked="ObsOption_Changed"/>
                            <RadioButton x:Name="ThemePillRadio" Content="Compact Pill" GroupName="ObsTheme" Style="{StaticResource ChipRadio}" Checked="ObsOption_Changed"/>
                        </WrapPanel>

                        <!-- Telemetry Elements -->
                        <TextBlock Text="Overlay Elements" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6"/>
                        <WrapPanel Margin="0,0,0,8">
                            <CheckBox x:Name="OptEcgCheck" Content="ECG Waveform" Style="{StaticResource ChipCheck}" IsChecked="True" Checked="ObsOption_Changed" Unchecked="ObsOption_Changed"/>
                            <CheckBox x:Name="OptZoneCheck" Content="HR Zone" Style="{StaticResource ChipCheck}" IsChecked="True" Checked="ObsOption_Changed" Unchecked="ObsOption_Changed"/>
                            <CheckBox x:Name="OptStatsCheck" Content="Min / Max" Style="{StaticResource ChipCheck}" Checked="ObsOption_Changed" Unchecked="ObsOption_Changed"/>
                            <CheckBox x:Name="OptNameCheck" Content="Watch Name" Style="{StaticResource ChipCheck}" Checked="ObsOption_Changed" Unchecked="ObsOption_Changed"/>
                            <CheckBox x:Name="OptAutoHideCheck" Content="Auto-hide Offline" Style="{StaticResource ChipCheck}" Checked="ObsOption_Changed" Unchecked="ObsOption_Changed"/>
                        </WrapPanel>

                        <!-- Generated URL + Copy / Preview -->
                        <Grid Margin="0,2,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="OverlayUrlBox" Style="{StaticResource UrlText}" Text="http://localhost:8764/"/>
                            <Button x:Name="CopyUrlButton" Grid.Column="1" Content="Copy URL" Style="{StaticResource PrimaryButton}"
                                    Padding="14,7" Margin="8,0,0,0" Click="CopyUrl_Click"/>
                            <Button Grid.Column="2" Content="Preview ↗" Style="{StaticResource SecondaryButton}"
                                    Padding="12,7" Margin="6,0,0,0" Click="OpenBrowser_Click"
                                    ToolTip="Open overlay URL in your default web browser"/>
                        </Grid>

                        <TextBlock Foreground="{StaticResource TextMutedBrush}" FontSize="11"
                                   Text="OBS setup: Add Browser Source → Paste URL → Size 400 × 120 px → Keep 'Shutdown source when not visible' OFF."/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ══════ PINNED STATUS FOOTER ══════ -->
        <Border Grid.Row="2" Background="{StaticResource BgSurfaceBrush}" BorderBrush="{StaticResource BorderSubtleBrush}" BorderThickness="0,1,0,0" Padding="20,9">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusBar" Style="{StaticResource StatusText}" Text="Starting local overlay servers…"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Ellipse x:Name="ServerHealthDot" Width="6" Height="6" Fill="{StaticResource GreenOkBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="OBS Clients:" Style="{StaticResource StatusText}" Margin="0,0,4,0"/>
                    <TextBlock x:Name="WsClientCount" Text="0" FontSize="11.5" FontWeight="Bold" FontFamily="{StaticResource MonoFont}" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
