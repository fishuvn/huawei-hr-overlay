<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Use Windows WinRT TFM when building for win-* RID (or on Windows with no RID); pure net8.0 on Linux & macOS -->
    <IsWindowsTarget Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">true</IsWindowsTarget>
    <IsWindowsTarget Condition="'$(RuntimeIdentifier)' == '' and '$(OS)' == 'Windows_NT'">true</IsWindowsTarget>

    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(IsWindowsTarget)' == 'true'">net8.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(IsWindowsTarget)' != 'true'">net8.0</TargetFramework>
    <DefineConstants Condition="'$(IsWindowsTarget)' == 'true'">$(DefineConstants);WINDOWS_BLE</DefineConstants>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>

    <RootNamespace>HuaweiHROverlay</RootNamespace>
    <AssemblyName>HuaweiHROverlay</AssemblyName>
    <ApplicationIcon>Assets\heart.ico</ApplicationIcon>

    <!-- Product metadata -->
    <Version>2.0.0</Version>
    <Company>HuaweiHROverlay</Company>
    <Product>Huawei HR Overlay for OBS</Product>
    <Copyright>2025-2026</Copyright>
    <Description>Cross-platform real-time Huawei Watch/Band BLE heart rate overlay for OBS Studio (Windows, Linux, macOS)</Description>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <CsWinRTEnabled>false</CsWinRTEnabled>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildVariant)' != ''">
    <AssemblyMetadata Include="BuildVariant" Value="$(BuildVariant)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Embed overlay.html so HTTP server serves it from single-file binaries on every OS -->
    <EmbeddedResource Include="Assets\overlay.html" />
    <AvaloniaResource Include="Assets\heart.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Tmds.DBus" Version="0.95.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(IsWindowsTarget)' == 'true'">
    <PackageReference Include="Microsoft.Windows.CsWinRT" Version="2.1.3" />
  </ItemGroup>

</Project>
